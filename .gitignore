# macOS
.DS_Store

# Impeccable: per-developer overrides and hook consent. The shared
# .impeccable/config.json IS committed — it carries the detector decisions.
.impeccable/config.local.json
.impeccable/questions/

# Claude Code machine-local settings
.claude/settings.local.json

# Fotografii și clipuri rămase din lucru: nu le folosește nicio pagină, dar
# rămân pe disc. Mutate aici după o verificare care a încărcat toate cele opt
# pagini și n-a găsit nicio cerere căzută.
img/_unused/

# Capturi și jurnale lăsate de Playwright în timpul verificărilor.
.playwright-mcp/

# Notele de proiect și configurările uneltelor. Cloudflare Pages publică
# depozitul așa cum e și servește inclusiv fișierele care încep cu punct, iar
# _redirects nu poate acoperi un fișier care chiar există: la Pages fișierul
# static are întâietate în fața regulii. Singurul mod sigur de a le ține în
# afara internetului e să nu ajungă în depozit. Rămân pe disc, unde le citește
# oricum sesiunea următoare, iar istoricul git le păstrează pe toate.
DESIGN.md
PRODUCT.md
.codex/
.impeccable/

# Marcatorul care deschide trecerea responsivă (vezi hook-ul Playwright).
# Gol, dar Pages publică tot depozitul, deci nu are ce căuta acolo.
.responsive-pass
